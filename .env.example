# Full env schema read by config.php. Values below are local-dev defaults.
# On the VPS, deploy-stack renders .env from the APPENV_-prefixed workflow
# secrets — only DB_PASSWORD is a secret (via APPENV_DB_PASSWORD); the rest
# fall back to config.php defaults.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=lithharbor
DB_USER=lithharbor
DB_PASSWORD=
